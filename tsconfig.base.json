{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": [
      "ES2025",
      "DOM",
      "DOM.Iterable"
    ],
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
